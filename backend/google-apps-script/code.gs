function doGet(e){const rid=rid_();try{const a=param_(e,'action');if(a==='ping')return json_({status:'ok',service:'tama-andrea-studio-backend',version:APP.VERSION,requestId:rid,time:new Date().toISOString()});if(a==='stats')return json_({status:'ok',requestId:rid,data:publicStats_(),updatedAt:dt_(new Date())});if(a==='track'){rate_('track:'+hashShort_(param_(e,'id')),APP.TRACK_LIMIT,APP.WINDOW);const id=orderId_(param_(e,'id'));if(!id)throw err_('VALIDATION_ERROR','ID pesanan tidak valid.');const o=findOrder_(id);if(!o)throw err_('NOT_FOUND','Pesanan tidak ditemukan.');return json_({status:'ok',requestId:rid,order:masked_(o)});}if(a==='admin')return renderAdmin_();return json_({status:'ok',service:'Tama Andrea Studio',version:APP.VERSION,requestId:rid,endpoints:['ping','stats','track','newOrder','verifyOrder','getVerifiedOrder']});}catch(e){logErr_(rid,'GET',e,e.code||'INTERNAL_ERROR');return error_(e.code||'INTERNAL_ERROR',publicMsg_(e),rid,e.retryAfterSeconds||0);}}
function doPost(e){const rid=rid_();let action='unknown';try{const b=body_(e);action=safe_(b.action,60);if(action==='newOrder'){const d=b.data||b;honeypot_(d);const crid=clientId_(b.clientRequestId||d.clientRequestId||'');rate_('order:'+hashShort_(crid||'anon'),APP.PUBLIC_ORDER_LIMIT,APP.WINDOW);return json_(newOrder_(d,{requestId:rid,clientRequestId:crid,source:'website'}));}if(action==='verifyOrder'){const id=b.id||b.orderId||'';rate_('verify:'+hashShort_(id+'|'+String(b.email||'')),APP.VERIFY_LIMIT,APP.WINDOW);return json_(verify_(id,b.name,b.email,rid));}if(action==='getVerifiedOrder')return json_(verifiedFetch_(b.id||b.orderId,b.verificationToken,rid));throw err_('UNKNOWN_ACTION','Action tidak dikenali.');}catch(e){logErr_(rid,action,e,e.code||'INTERNAL_ERROR');return error_(e.code||'INTERNAL_ERROR',publicMsg_(e),rid,e.retryAfterSeconds||0);}}
function setupBackend(){const ss=sheetFile_();Object.keys(SHEETS).forEach(k=>ensure_(ss,SHEETS[k],H[k]));if(getSheet_(SHEETS.CATALOG).getLastRow()<2)seedCatalog_();seedBoot_();seedNotes_();const p=PropertiesService.getScriptProperties(),o=getSheet_(SHEETS.ORDERS);if(!p.getProperty('TA_ORDER_SEQ'))p.setProperty('TA_ORDER_SEQ',String(maxOrder_(o)));const s=getSheet_(SHEETS.SETTINGS);[['BACKEND_VERSION',APP.VERSION,'Backend version'],['PUBLIC_TRACKING','MASKED_UNTIL_VERIFIED','Public tracking masks customer data'],['PUBLIC_CUSTOMER_ACCESS','DENIED','Customers never exposed publicly'],['ADMIN_AUTH','3_LAYER_HASHED_SESSION','Gate/code/identity/password/session'],['PRICING_ENGINE','SERVICE_CATALOG_RULES','Configurable service catalog'],['DATA_RETENTION','ADMIN_CONTROLLED','Retention policy documented in Settings']].forEach(x=>setting_(s,x[0],x[1],x[2]));SpreadsheetApp.flush();return{status:'success',version:APP.VERSION,sheets:Object.keys(SHEETS).map(k=>SHEETS[k]),orderSequence:Number(p.getProperty('TA_ORDER_SEQ')||0)};}
function runHealthCheck(){const r={status:'ok',version:APP.VERSION,time:new Date().toISOString(),sheets:{},config:{},catalog:{}};try{const ss=sheetFile_();Object.keys(SHEETS).forEach(k=>r.sheets[SHEETS[k]]=!!ss.getSheetByName(SHEETS[k]));const p=PropertiesService.getScriptProperties();r.config.adminConfigured=!!p.getProperty('TA_ADMIN_GATE_HASH')&&!!p.getProperty('TA_ADMIN_CODE_HASH')&&!!p.getProperty('TA_ADMIN_PASSWORD_HASH');r.config.orderSequence=Number(p.getProperty('TA_ORDER_SEQ')||0);const c=catalog_();r.catalog.total=c.length;r.catalog.active=c.filter(x=>x.active).length;r.status=Object.keys(r.sheets).every(k=>r.sheets[k])?'ok':'warning';return r;}catch(e){r.status='error';r.error='Health check gagal.';logErr_(rid_(),'health',e,'HEALTH_CHECK_FAILED');return r;}}
function configureAdminSecurity(){const ui=SpreadsheetApp.getUi(),gate=prompt_(ui,'Tahap 1 — Kode Gerbang Admin'),code=prompt_(ui,'Tahap 2 — Kode Akses Admin'),name=prompt_(ui,'Tahap 3 — Nama Admin'),email=prompt_(ui,'Tahap 3 — Email Admin'),pass=prompt_(ui,'Tahap 3 — Password Admin');if([gate,code,name,email,pass].some(v=>v===null))return;const n=normalizeId_(name),e=String(email).trim().toLowerCase();if(String(gate).trim().length<12||String(code).trim().length<12||String(pass).length<12||gate===code||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)||n.length<2){ui.alert('Konfigurasi tidak valid. Kode minimal 12 karakter, password minimal 12 karakter, nama/email harus valid.');return;}const p=PropertiesService.getScriptProperties(),gs=token_(),cs=token_(),ps=token_(),is=token_();p.setProperties({TA_ADMIN_GATE_SALT:gs,TA_ADMIN_GATE_HASH:hash_(String(gate).trim(),gs),TA_ADMIN_CODE_SALT:cs,TA_ADMIN_CODE_HASH:hash_(String(code).trim(),cs),TA_ADMIN_ID_SALT:is,TA_ADMIN_NAME_HASH:hash_(n,is),TA_ADMIN_EMAIL_HASH:hash_(e,is),TA_ADMIN_PASSWORD_SALT:ps,TA_ADMIN_PASSWORD_HASH:hash_(String(pass),ps),TA_ADMIN_CONFIGURED_AT:new Date().toISOString()},true);ui.alert('Konfigurasi admin tersimpan. Secret tidak ditulis ke GitHub.');writeAudit_(rid_(),'admin-setup','CONFIGURE_SECURITY','','SUCCESS','Admin security diperbarui.');}
function prompt_(ui,title){const r=ui.prompt(title,'Masukkan nilai untuk tahap ini.',ui.ButtonSet.OK_CANCEL);return r.getSelectedButton()===ui.Button.OK?String(r.getResponseText()||''):null;}
function adminGate(v){const rid=rid_();try{rate_('admin-gate',5,APP.WINDOW);const p=PropertiesService.getScriptProperties(),s=p.getProperty('TA_ADMIN_GATE_SALT'),h=p.getProperty('TA_ADMIN_GATE_HASH');if(!s||!h)throw err_('ADMIN_NOT_CONFIGURED','Admin belum dikonfigurasi.');if(!safeEq_(hash_(String(v||'').trim(),s),h))throw retryErr_('GATE_DENIED','Kode gerbang tidak valid.',180);const t=token_();CacheService.getScriptCache().put('ta:gate:'+t,'1',APP.ADMIN_STAGE_SECONDS);return{status:'ok',stageToken:t,expiresIn:APP.ADMIN_STAGE_SECONDS,requestId:rid};}catch(e){return failAdmin_(rid,'adminGate',e);}}
function adminCode(t,v){const rid=rid_();try{if(!CacheService.getScriptCache().get('ta:gate:'+t))throw err_('STAGE_EXPIRED','Tahap pertama kedaluwarsa.');rate_('admin-code:'+hashShort_(t),5,APP.WINDOW);const p=PropertiesService.getScriptProperties(),s=p.getProperty('TA_ADMIN_CODE_SALT'),h=p.getProperty('TA_ADMIN_CODE_HASH');if(!s||!h)throw err_('ADMIN_NOT_CONFIGURED','Kode akses belum dikonfigurasi.');if(!safeEq_(hash_(String(v||'').trim(),s),h))throw retryErr_('CODE_DENIED','Kode akses admin tidak valid.',180);CacheService.getScriptCache().remove('ta:gate:'+t);const x=token_();CacheService.getScriptCache().put('ta:verify:'+x,'1',APP.ADMIN_STAGE_SECONDS);return{status:'ok',verifyToken:x,expiresIn:APP.ADMIN_STAGE_SECONDS,requestId:rid};}catch(e){return failAdmin_(rid,'adminCode',e);}}
function adminVerify(t,payload){const rid=rid_();try{if(!CacheService.getScriptCache().get('ta:verify:'+t))throw err_('STAGE_EXPIRED','Tahap verifikasi kedaluwarsa.');rate_('admin-verify:'+hashShort_(t),5,APP.WINDOW);const p=PropertiesService.getScriptProperties(),is=p.getProperty('TA_ADMIN_ID_SALT'),nh=p.getProperty('TA_ADMIN_NAME_HASH'),eh=p.getProperty('TA_ADMIN_EMAIL_HASH'),ps=p.getProperty('TA_ADMIN_PASSWORD_SALT'),ph=p.getProperty('TA_ADMIN_PASSWORD_HASH');if(!is||!nh||!eh||!ps||!ph)throw err_('ADMIN_NOT_CONFIGURED','Identitas/password admin belum dikonfigurasi.');const name=normalizeId_(payload&&payload.name),email=String(payload&&payload.email||'').trim().toLowerCase(),pass=String(payload&&payload.password||'');if(!safeEq_(hash_(name,is),nh)||!safeEq_(hash_(email,is),eh)||!safeEq_(hash_(pass,ps),ph))throw retryErr_('AUTH_FAILED','Nama, email, atau password admin tidak cocok.',300);CacheService.getScriptCache().remove('ta:verify:'+t);const s=token_();CacheService.getScriptCache().put('ta:admin:'+s,'1',APP.ADMIN_SESSION_SECONDS);writeAudit_(rid,'admin','LOGIN','','SUCCESS','Admin login berhasil.');return{status:'ok',token:s,expiresIn:APP.ADMIN_SESSION_SECONDS,adminName:String(payload.name||'Admin').trim(),requestId:rid};}catch(e){return failAdmin_(rid,'adminVerify',e);}}
function adminLogoutSecure(t){if(t)CacheService.getScriptCache().remove('ta:admin:'+String(t));return{status:'ok'};}
function requireAdmin_(t){if(!t||!CacheService.getScriptCache().get('ta:admin:'+String(t)))throw err_('ADMIN_SESSION_EXPIRED','Sesi admin kedaluwarsa. Silakan login lagi.');}
