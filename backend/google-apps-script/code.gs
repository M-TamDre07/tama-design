function safeCell_(v){const t=safe_(v,5000);return/^[=+\-@]/.test(t)?"'"+t:t;}
function normalize_(v){return String(v==null?'':v).trim().toLowerCase().replace(/\s+/g,' ');}
function normalizeId_(v){return normalize_(String(v||'').normalize('NFKC'));}
function clientId_(v){const t=safe_(v,100);if(!t)return'';if(!/^[A-Za-z0-9._:-]{8,100}$/.test(t))throw err_('VALIDATION_ERROR','Client Request ID tidak valid.');return t;}
function orderId_(v){const t=String(v||'').trim().toUpperCase().replace(/^ORD[-\s]?/,'');const id=t?'ORD-'+t:'';return/^ORD-\d{1,12}$/.test(id)?id:'';}
function mask_(n){const p=String(n||'').trim().split(/\s+/);return p.map((x,i)=>i?x.charAt(0)+'***':x.slice(0,2)+'***').join(' ');}
function formatDate_(v){const d=v instanceof Date?v:new Date(v);return isNaN(d.getTime())?'':Utilities.formatDate(d,APP.TIMEZONE,'dd/MM/yyyy');}
function dt_(v){const d=v instanceof Date?v:new Date(v);return Utilities.formatDate(d,APP.TIMEZONE,'dd/MM/yyyy HH:mm:ss');}
function fmt_(v){return new Intl.NumberFormat('id-ID').format(Number(v)||0);}
function daysLeft_(v){if(!v)return'';const d=v instanceof Date?v:new Date(v);if(isNaN(d.getTime()))return'';const n=new Date(),a=new Date(n.getFullYear(),n.getMonth(),n.getDate()),b=new Date(d.getFullYear(),d.getMonth(),d.getDate());return Math.ceil((b-a)/86400000);}
function addBusinessDays_(d,n){const x=new Date(d.getTime());while(n>0){x.setDate(x.getDate()+1);if(x.getDay()!==0&&x.getDay()!==6)n--;}return x;}
function parseDate_(v){const d=new Date(String(v||''));if(isNaN(d.getTime()))throw err_('VALIDATION_ERROR','Tanggal tidak valid.');return d;}
function enum_(v,a,label){const t=safe_(v,100);if(a.indexOf(t)<0)throw err_('VALIDATION_ERROR',label+' tidak valid.');return t;}
function int_(v,min,max,label){const n=Number(v);if(!Number.isInteger(n)||n<min||n>max)throw err_('VALIDATION_ERROR',label+' tidak valid.');return n;}
function has_(o,k){return Object.prototype.hasOwnProperty.call(o,k);}
