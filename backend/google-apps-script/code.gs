function createNewOrderRecord_(params,meta){const req=meta.requestId||makeRequestId_(),input=normalizeOrderInput_(params||{});validatePayloadSize_(input);if(meta.clientRequestId)input.clientRequestId=normalizeClientRequestId_(meta.clientRequestId);if(input.clientRequestId){const old=findRequest_(input.clientRequestId);if(old){const ex=findOrderById_(old);return{status:'ok',duplicate:true,id:old,orderId:old,requestId:req,estimate:ex?ex.estimasi:0};}}const analysis=analyzeOrder_(input.layanan,input.brief,input.os),lock=LockService.getScriptLock();lock.waitLock(10000);try{const s=getOrdersSheet_(),id=nextOrderId_(s),now=new Date(),due=addBusinessDays_(now,analysis.days),r=new Array(ORDER_HEADERS.length).fill('');r[0]=id;r[1]=now;r[2]=now;r[3]=safeCell_(input.nama);r[4]=safeCell_(input.email);r[5]=safeCell_(input.wa);r[6]=safeCell_(input.kategori);r[7]=safeCell_(input.layanan);r[8]=safeCell_(input.os);r[9]=safeCell_(input.metode);r[10]=safeCell_(input.brief);r[11]=due;r[12]='Pending';r[13]=analysis.estimate;r[14]='Belum Bayar';r[15]=0;r[17]=analysis.priority;r[18]=analysis.days;r[19]=safeCell_(meta.source||'website');r[20]=safeCell_(input.clientRequestId);r[21]=safeCell_('Analyzer: '+analysis.summary+' | Risiko: '+(analysis.risks.join(', ')||'none'));const rn=s.getLastRow()+1;s.getRange(rn,1,1,ORDER_HEADERS.length).setValues([r]);s.getRange(rn,2,1,2).setNumberFormat('dd/MM/yyyy HH:mm');s.getRange(rn,12).setNumberFormat('dd/MM/yyyy');s.getRange(rn,14).setNumberFormat('#,##0');upsertCustomer_(input,id,now);if(input.clientRequestId)saveRequest_(input.clientRequestId,id,req);writeAudit_(req,meta.source==='admin'?'admin':'public','CREATE_ORDER',id,'SUCCESS','Order dibuat.');return{status:'ok',id:id,orderId:id,requestId:req,layanan:input.layanan,estimate:'Rp '+formatRupiah_(analysis.estimate),estimatePrice:analysis.estimate,estimateMin:analysis.min,estimateMax:analysis.max,deadline:formatDate_(due),priority:analysis.priority,days:analysis.days,analysis:{quality:analysis.quality,riskFlags:analysis.risks}};}finally{lock.releaseLock();}}
function normalizeOrderInput_(p){const nama=sanitizePlain_(p.Nama||p['Nama Lengkap']||p.nama,80),email=normalizeEmail_(p.Email||p['Alamat Email']),wa=String(p.WA||p.WhatsApp||p['Kontak/WA']||'').replace(/[^\d+]/g,''),kategori=sanitizePlain_(p.Kategori||p['Kategori Layanan']||p['Jenis Desain'],50),layanan=sanitizePlain_(p.Layanan||p['Layanan Dipilih']||p.service,800),os=sanitizePlain_(p.OS||p['Pilihan OS'],60),metode=sanitizePlain_(p.Metode||p['Metode Layanan'],150),brief=sanitizePlain_(p.Brief||p['Rincian Brief']||p['Keterangan Proyek'],5000);if(nama.length<2)throw appError_('VALIDATION_ERROR','Nama minimal 2 karakter.');if(!/^\S+@\S+\.\S+$/.test(email))throw appError_('VALIDATION_ERROR','Format email tidak valid.');if(wa&&!/^\+?\d{8,15}$/.test(wa))throw appError_('VALIDATION_ERROR','Nomor WhatsApp tidak valid.');if(layanan.length<2)throw appError_('VALIDATION_ERROR','Layanan belum dipilih.');if(brief.length<5)throw appError_('VALIDATION_ERROR','Keterangan kebutuhan terlalu singkat.');if(os&&APP.OS.indexOf(os)<0)throw appError_('VALIDATION_ERROR','Pilihan OS tidak dikenali.');if(metode&&APP.METHOD.indexOf(metode)<0)throw appError_('VALIDATION_ERROR','Metode layanan tidak dikenali.');const c=normalizeSearch_(kategori),l=normalizeSearch_(layanan);if(c.indexOf('desain')>=0&&/(paket os|ram|cpu|gpu|psu|ssd|hdd|iphone|find hub|windows|office|diagnosis)/i.test(l))throw appError_('VALIDATION_ERROR','Layanan IT tidak cocok dengan kategori desain.');if((c.indexOf('servis')>=0||c.indexOf('it')>=0)&&/(poster|banner|logo|presentasi|media sosial|foto produk)/i.test(l))throw appError_('VALIDATION_ERROR','Layanan desain tidak cocok dengan kategori servis IT.');return{nama:nama,email:email,wa:wa,kategori:kategori,layanan:layanan,os:os,metode:metode,brief:brief,clientRequestId:normalizeClientRequestId_(p.clientRequestId||p['Client Request ID']||'')};}
function analyzeOrder_(layanan,briefText,os){const selected=String(layanan||'').split(/\s*,\s*/).filter(Boolean),brief=String(briefText||'').toLowerCase();let base=0,min=0,max=0,known=0;selected.forEach(function(i){const key=resolveService_(i);if(key){const c=SERVICE_CATALOG[key];base+=c.base;min+=c.min;max+=c.max;known++;}});if(!base){base=/servis|diagnosis|os|windows|ubuntu|debian|kali|ram|cpu|gpu|psu|ssd|hdd|iphone|find hub/i.test(layanan)?85000:20000;min=base;max=base;}let mult=1,days=2,priority='Normal',risks=[];if(/hari ini|besok|urgent|mendesak|secepatnya/.test(brief)){mult*=1.1;days=1;priority='Tinggi';risks.push('deadline-mendesak');}if(/kompleks|animasi|3d|banyak halaman|branding lengkap|revisi banyak/.test(brief)){mult*=1.15;days+=2;if(priority!=='Tinggi')priority='Menengah';risks.push('brief-kompleks');}if(/sederhana|simple|ringan|satu halaman|satu desain/.test(brief)){mult*=.95;days=Math.max(1,days-1);if(priority==='Normal')priority='Rendah';}if(selected.length>1){mult*=1.05;days+=Math.min(2,selected.length-1);risks.push('multi-layanan');}const quality=calculateBriefQuality_(briefText);if(quality<50)risks.push('brief-perlu-diperjelas');if(!os&&/paket os|windows|ubuntu|debian|kali/i.test(layanan))risks.push('OS-belum-dipilih');if(known<selected.length)risks.push('layanan-tidak-dikenal');const estimate=Math.max(5000,Math.round(base*mult/5000)*5000);return{estimate:estimate,min:Math.round(min*mult/5000)*5000,max:Math.round(max*mult/5000)*5000,priority:priority,days:days,quality:quality,risks:risks,summary:'base='+base+', mult='+mult.toFixed(2)+', known='+known+'/'+selected.length};}
function calculateBriefQuality_(b){const s=String(b||'').trim();let q=s?20:0;if(s.length>=30)q+=15;if(s.length>=80)q+=15;if(s.length>=160)q+=10;if(/ukuran|size|dimensi|px|cm|mm/i.test(s))q+=10;if(/deadline|tenggat|tanggal|besok|hari/i.test(s))q+=10;if(/referensi|contoh|warna|brand|target|tujuan/i.test(s))q+=15;if(/format|png|jpg|pdf|pptx|ai|psd|svg/i.test(s))q+=5;return Math.min(100,q);}
