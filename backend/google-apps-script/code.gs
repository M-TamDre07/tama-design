function analyzeOrder_(layanan,briefText,os){const serviceString=String(layanan||''),brief=String(briefText||'').trim().toLowerCase(),selected=splitServices_(serviceString);let base=0,minPrice=0,maxPrice=0,known=0;const groups={};selected.forEach(function(item){const key=findCatalogKey_(item);if(key){const c=SERVICE_CATALOG[key];base+=c.base;minPrice+=c.min;maxPrice+=c.max;groups[c.group]=(groups[c.group]||0)+1;known++}else{base+=25000;minPrice+=25000;maxPrice+=50000}});if(!base){base=/servis|OS|Windows|Ubuntu|Debian|Kali|RAM|CPU|GPU|PSU|SSD|HDD|iPhone/i.test(serviceString)?90000:20000;minPrice=base;maxPrice=base}const urgent=/(urgent|besok|segera|buru|mendesak|hari ini|malam ini)/i.test(brief),complex=/(3d|animasi|manipulasi|detail|banyak halaman|banyak konsep|multi|branding lengkap|revisi banyak|kompleks|custom)/i.test(brief),light=/(sederhana|simple|simpel|ringan|satu halaman|satu desain)/i.test(brief),quality=calculateBriefQuality_(briefText),itWork=Object.keys(groups).some(function(g){return g.indexOf('it')===0});let multiplier=1,priority='Normal',days=itWork?2:3;const risks=[];if(urgent){multiplier*=1.10;priority='Tinggi';days=Math.max(1,days-1);risks.push('deadline-mendesak')}if(complex){multiplier*=1.15;if(priority!=='Tinggi')priority='Menengah';days+=2;risks.push('brief-kompleks')}if(light&&!urgent&&!complex){multiplier*=0.95;priority='Rendah';days=Math.max(1,days-1)}if(quality<50)risks.push('brief-perlu-diperjelas');if(known<selected.length)risks.push('layanan-tidak-dikenal');if(!os&&/(install|instalasi|OS|Windows|Ubuntu|Debian|Kali)/i.test(serviceString))risks.push('OS-belum-dipilih');const fixed=selected.length===1&&known===1&&minPrice===maxPrice,estimate=fixed?minPrice:roundToThousand_(base*multiplier),min=fixed?minPrice:roundToThousand_(minPrice*multiplier),max=fixed?maxPrice:roundToThousand_(maxPrice*multiplier);return{estimate:estimate,min:min,max:max,priority:priority,days:Math.max(1,Math.min(7,days)),difficulty:complex?'Kompleks':(light?'Ringan':(i