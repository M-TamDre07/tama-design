function readPostBody_(e){const content=e&&e.postData&&e.postData.contents?String(e.postData.contents):'{}';if(content.length>APP.MAX_BODY_BYTES)throw appError_('PAYLOAD_TOO_LARGE','Ukuran permintaan melebihi batas.');try{return JSON.parse(content)}catch(_){if(e&&e.parameter)return e.parameter;throw appError_('INVALID_JSON','Data yang dikirim bukan JSON yang valid.')}}
function getParam_(e,key){return e&&e.parameter?String(e.parameter[key]||''):''}
function jsonResponse_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
function errorResponse_(code,message,requestId){return jsonResponse_({status:'error',code:code,message:message,requestId:requestId})}
function errorObject_(code,message,requestId){return{status:'error',code:code,message:message,requestId:requestId}}
function publicErrorMessage_(err){return err&&err.code?String(err.message||'Permintaan tidak dapat diproses.'):'Server mengalami kendala. Silakan coba lagi.'}
function appError_(code,message){const e=new Error(message);e.code=code;return e}
function makeRequestId_(){return'REQ-'+Utilities.getUuid().replace(/-/g,'').slice(0,20).toUpperCase()}
function makeToken_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'')}
function hash_(value,salt){let text=String(salt)+'|'+String(value);for(let i=0;i<2500;i++)text=bytesToHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text,Utilities.Charset.UTF_8));return text}
function hashShort_(text){return bytesToHex_(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(text),Utilities.Charset.UTF_8)).slice(0,20)}
function bytesToHex_(bytes){return bytes.map(function(b){const n=b<0?b+256:b;return('0'+n.toString(16)).slice(-2)}).join('')}
function safeCell_(value){const text=sanitizePlain_(value,10000);return/^[=+\-@]/.test(text)?"'"+text:text}
function sanitizePlain_(value,max){const text=String(value==null?'':value).replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/g,' ').replace(/\s+/g,' ').trim();return text.length>max?text.slice(0,max):text}
function normalize_(value){return normalizeSearch_(value)}
function normalizeSearch_(value){return String(value==null?'':value).toLowerCase().trim()}
function normalizeIdentity_(value){return normalizeSearch_(String(value||'').replace(/[^\p{L}\p{N} ]/gu,'').replace(/\s+/g,' '))}
function normalizeEmail_(value){return String(value||'').trim().toLowerCase()}
function normalizeOrderId_(value){const raw=sanitizePlain_(value,30).toUpperCase().replace(/^ORD[-\s]?/,'');if(!raw)return'';const id=APP.ORDER_PREFIX+raw.padStart(APP.ORDER_WIDTH,'0');return/^ORD-\d{1,12}$/.test(id)?id:''}
function normalizeClientRequestId_(value){const text=sanitizePlain_(value,100);if(!text)return'';if(!/^[A-Za-z0-9._:-]{8,100}$/.test(text))throw appError_('VALIDATION_ERROR','Client Request ID tidak valid.');return text}
function valueString_(value){return value==null?'':String(value)}
function parseNumber_(value){const n=Number(String(value==null?'':value).replace(/[^\d.-]/g,''));return isNaN(n)?0:n}
function formatRupiah_(value){return new Intl.NumberFormat('id-ID').format(parseNumber_(value))}
function roundToThousand_(value){return Math.max(0,Math.round(Number(value||0)/1000)*1000)}
function formatDate_(value){const d=value instanceof Date?value:new Date(value);return isNaN(d.getTime())?'':Utilities.formatDate(d,APP.TIMEZONE,'dd/MM/yyyy')}
function formatDateTime_(value){return Utilities.formatDate(value instanceof Date?value:new Date(value),APP.TIMEZONE,'dd/MM/yyyy HH:mm:ss')}
function formatDateTimeValue_(value){if(!value)return'';try{return formatDateTime_(value)}catch(_){return String(value)}}
function formatDateValue_(value){if(!value)return'';try{return formatDate_(value)}catch(_){return String(value)}}
function nowIso_(){return new Date().toISOString()}
function computeDaysLeft_(dateValue){if(!dateValue)return'';const due=dateValue instanceof Date?dateValue:new Date(dateValue);if(isNaN(due.getTime()))return'';const t=new Date(),a=new Date(t.getFullYear(),t.getMonth(),t.getDate()),b=new Date(due.getFullYear(),due.getMonth(),due.getDate());return Math.ceil((b-a)/86400000)}
function addBusinessDays_(date,days){const d=new Date(date.getTime());let left=Number(days)||0;while(left>0){d.setDate(d.getDate()+1);const day=d.getDay();if(day!==0&&day!==6)left--}return d}
function parseDateInput_(value,label){const text=sanitizePlain_(value,40);if(!text)throw appError_('VALIDATION_ERROR',label+' diperlukan.');const d=new Date(text);if(isNaN(d.getTime()))throw appError_('VALIDATION_ERROR',label+' tidak valid.');return d}
function validateEnum_(value,allowed,label){const text=sanitizePlain_(value,100);if(allowed.indexOf(text)===-1)throw appError_('VALIDATION_ERROR',label+' tidak valid.');return text}
function clampInt_(value,min,max,label){const n=Number(value);if(!Number.isInteger(n)||n<min||n>max)throw appError_('VALIDATION_ERROR',label+' tidak valid.');return n}
function hasOwn_(obj,key){return Object.prototype.hasOwnProperty.call(obj,key)}
function validatePayloadSize_(p){if(JSON.stringify(p||{}).length>APP.MAX_BODY_BYTES)throw appError_('PAYLOAD_TOO_LARGE','Data yang dikirim terlalu besar.')}
function findCatalogKey_(item){const n=normalizeSearch_(item),keys=Object.keys(SERVICE_CATALOG);for(let i=0;i<keys.length;i++){const k=normalizeSearch_(keys[i]);if(n===k||n.indexOf(k)!==-1||k.indexOf(n)!==-1)return keys[i]}return null}
function splitServices_(value){return String(value||'').split(/,|\n|;/).map(function(v){return v.trim()}).filter(Boolean)}
function maskName_(name){const parts=String(name||'').trim().split(/\s+/).filter(Boolean);if(!parts.length)return'—';return parts.map(function(p){return p.length<=2?p.charAt(0)+'•':p.slice(0,2)+'•'.repeat(Math.min(4,Math.max(2,p.length-2)))}).join(' ')}
