function doGet(e){const rid=makeRequestId_();try{const a=getParam_(e,'action');if(a==='ping')return json_({status:'ok',service:'tama-andrea-studio-backend',version:APP.VERSION,requestId:rid,time:nowIso_()});if(a==='stats')return json_({status:'ok',requestId:rid,data:getPublicStats_(),updatedAt:formatDateTime_(new Date())});if(a==='track'){if(String(getParam_(e,'id')).length>80)throw appError_('VALIDATION_ERROR','Parameter terlalu panjang.');enforceRate_('public-track',APP.PUBLIC_LIMIT,APP.PUBLIC_WINDOW);const id=normalizeOrderId_(getParam_(e,'id'));if(!id)return errorResponse_('VALIDATION_ERROR','ID pesanan tidak valid.',rid);const o=findOrderById_(id);return o?json_({status:'ok',requestId:rid,order:publicOrder_(o)}):errorResponse_('NOT_FOUND','Pesanan tidak ditemukan.',rid);}if(a==='admin')return renderAdmin_();return json_({status:'ok',service:'Tama Andrea Studio',version:APP.VERSION,requestId:rid});}catch(err){logError_(rid,'GET',err.code||'INTERNAL_ERROR',err);return errorResponse_(err.code||'INTERNAL_ERROR',err.message||'Server mengalami kendala.',rid);}}
function doPost(e){const rid=makeRequestId_();let action='unknown';try{const raw=readBody_(e);action=String(raw.action||'').trim();if(!action)return errorResponse_('VALIDATION_ERROR','Action tidak ditemukan.',rid);if(action==='newOrder'){const d=raw.data||raw,crid=normalizeClientRequestId_(raw.clientRequestId||d.clientRequestId||'');enforceRate_('public-order',APP.PUBLIC_LIMIT,APP.PUBLIC_WINDOW);return json_(createNewOrderRecord_(d,{requestId:rid,clientRequestId:crid,source:'website'}));}if(action==='verifyOrder'){const id=raw.id||raw.orderId||'',name=raw.name||'',email=raw.email||'';enforceRate_('verify:'+hashShort_(id),APP.VERIFY_LIMIT,APP.VERIFY_WINDOW);return json_(verifyOrder_(id,name,email,rid));}if(action==='getVerifiedOrder')return json_(getVerifiedOrder_(raw.id||raw.orderId||'',raw.verificationToken||'',rid));return errorResponse_('UNKNOWN_ACTION','Action tidak dikenali.',rid);}catch(err){logError_(rid,action,err.code||'INTERNAL_ERROR',err);return errorResponse_(err.code||'INTERNAL_ERROR',err.message||'Permintaan tidak dapat diproses.',rid);}}
function setupBackend(){const ss=getSpreadsheet_();[[SHEETS.ORDERS,ORDER_HEADERS],[SHEETS.CUSTOMERS,CUSTOMER_HEADERS],[SHEETS.AUDIT,AUDIT_HEADERS],[SHEETS.ERRORS,ERROR_HEADERS],[SHEETS.REQUESTS,REQUEST_HEADERS],[SHEETS.SETTINGS,SETTINGS_HEADERS],[SHEETS.SERVICE_NOTES,['Note ID','Kategori','Judul','Ringkasan','Langkah Kerja','Peringatan / Batasan','Updated At']],[SHEETS.BOOT_KEYS,['Brand','Jenis Perangkat','Model / Motherboard','BIOS / UEFI','Boot Menu','Catatan','Updated At']]].forEach(function(d){configureSheet_(getOrCreateSheet_(ss,d[0],d[1]),d[1]);});const p=PropertiesService.getScriptProperties(),orders=ss.getSheetByName(SHEETS.ORDERS);if(!p.getProperty('TA_ORDER_SEQ'))p.setProperty('TA_ORDER_SEQ',String(findMaxOrderNumber_(orders)));const st=ss.getSheetByName(SHEETS.SETTINGS);writeSetting_(st,'BACKEND_VERSION',APP.VERSION,'Versi backend aktif.');writeSetting_(st,'TIMEZONE',APP.TIMEZONE,'Zona waktu operasional.');writeSetting_(st,'PUBLIC_TRACKING','MASKED_UNTIL_VERIFIED','Nama dan email disensor sampai verifikasi.');writeSetting_(st,'ADMIN_AUTH','3_LAYER','Gerbang → kode akses → identitas/password.');writeSetting_(st,'HOME_VISIT','SATURDAY_SUNDAY','Home visit hanya Sabtu/Minggu.');SpreadsheetApp.flush();return{status:'success',version:APP.VERSION,orderSequence:Number(p.getProperty('TA_ORDER_SEQ')||0)};}
function getOrCreateSheet_(ss,n,h){let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);ensureHeaders_(s,h);return s;}function configureSheet_(s,h){ensureHeaders_(s,h);s.setFrozenRows(1);try{s.getRange(1,1,1,h.length).setFontWeight('bold');}catch(_){}}function ensureHeaders_(s,h){if(s.getLastRow()===0){s.getRange(1,1,1,h.length).setValues([h]);return;}const ex=s.getRange(1,1,1,Math.max(h.length,s.getLastColumn())).getDisplayValues()[0];for(let i=0;i<h.length;i++)if(normalizeSearch_(ex[i])!==normalizeSearch_(h[i]))s.getRange(1,i+1).setValue(h[i]);}
function getDashboardData(searchTerm,token){requireAdmin_(token);const s=getOrdersSheet_(),q=normalizeSearch_(searchTerm),rows=q?searchOrders_(s,q):recentOrders_(s,APP.PAGE_SIZE);return{status:'ok',version:APP.VERSION,stats:dashboardStats_(s),orders:rows,sheetName:s.getName()};}
