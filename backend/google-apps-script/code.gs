function searchOrders_(sheet,term){const q=normalizeSearch_(term);if(!q)return recentOrders_(sheet,APP.PAGE_SIZE);const last=sheet.getLastRow();if(last<2)return [];const rows=sheet.getRange(2,1,last-1,ORDER_HEADERS.length).getValues(),scored=[];rows.forEach(function(r,i){if(!r[0])return;const id=normalizeSearch_(r[0]),name=normalizeSearch_(r[3]),email=normalizeSearch_(r[4]),wa=normalizeSearch_(r[5]),cat=normalizeSearch_(r[6]),service=normalizeSearch_(r[7]),os=normalizeSearch_(r[8]),status=normalizeSearch_(r[12]),hay=[id,name,email,wa,cat,service,os,status].join(' ');if(hay.indexOf(q)===-1)return;let score=1;if(id===q)score+=100;else if(id.indexOf(q)===0)score+=50;if(email===q)score+=80;else if(email.indexOf(q)===0)score+=35;if(name===q)score+=60;else if(name.indexOf(q)===0)score+=30;if(wa===q)score+=70;if(service.indexOf(q)!==-1)score+=15;if(status===q)score+=10;scored.push({row:r,score:score,index:i})});scored.sort(function(a,b){return b.score-a.score||b.index-a.index});return scored.slice(0,APP.MAX_PAGE_SIZE).map(function(x){return rowToOrder_(x.row,x.index+2)})}
function recentOrders_(sheet,limit){const last=sheet.getLastRow();if(last<2)return [];const n=Math.min(Number(limit)||APP.PAGE_SIZE,APP.MAX_PAGE_SIZE),start=Math.max(2,last-n+1),rows=sheet.getRange(start,1,last-start+1,ORDER_HEADERS.length).getValues().reverse();return rows.filter(function(r){return r[0]}).map(function(r,i){return rowToOrder_(r,last-i)})}
function rowToOrder_(r,rowNumber){const pay=valueString_(r[14])||'Belum Bayar';return{row:rowNumber||'',id:valueString_(r[0]),tanggalMasuk:formatDateTimeValue_(r[1]),tanggalUpdate:formatDateTimeValue_(r[2]),nama:valueString_(r[3]),email:valueString_(r[4]),wa:valueString_(r[5]),kategori:valueString_(r[6]),layanan:valueString_(r[7]),os:valueString_(r[8]),metode:valueString_(r[9]),brief:valueString_(r[10]),tenggat:formatDateValue_(r[11]),status:valueString_(r[12])||'Pending',biaya:r[13]===''?'':'Rp '+formatRupiah_(r[13]),estimasi:r[13]===''?0:parseNumber_(r[13]),estimatePrice:parseNumber_(r[13]),statusPembayaran:pay,payment:pay,revisi:r[15]===''?'0':String(r[15]),link:valueString_(r[16]),prioritas:valueString_(r[17])||'Normal',hariTersisa:r[18]===''?'':String(computeDaysLeft_(r[11])),sumber:valueString_(r[19]),clientRequestId:valueString_(r[20]),catatan:valueString_(r[21])}}
function findOrderRow_(id){const sheet=getOrdersSheet_(),last=sheet.getLastRow(),target=String(id||'').trim().toUpperCase();if(last<2)return null;const ids=sheet.getRange(2,1,last-1,1).getDisplayValues().flat();for(let i=0;i<ids.length;i++)if(String(ids[i]||'').trim().toUpperCase()===target)return{sheet:sheet,row:i+2,values:sheet.getRange(i+2,1,1,ORDER_HEADERS.length).getValues()[0],id:target};return null}
function findOrderById_(id){const f=findOrderRow_(id);return f?rowToOrder_(f.values,f.row):null}
function getOrdersSheet_(){const ss=getSpreadsheet_();let sheet=ss.getSheetByName(SHEETS.ORDERS);if(!sheet){setupBackend();sheet=ss.getSheetByName(SHEETS.ORDERS)}if(!sheet)throw new Error('Sheet Orders tidak ditemukan.');return sheet}
function getSpreadsheet_(){const p=PropertiesService.getScriptProperties(),id=String(p.getProperty('TA_SPREADSHEET_ID')||'').trim();if(id){try{return SpreadsheetApp.openById(id)}catch(_){throw new Error('Spreadsheet ID pada Script Properties tidak dapat dibuka.')}}const active=SpreadsheetApp.getActiveSpreadsheet();if(!active)throw new Error('Spreadsheet aktif tidak ditemukan.');return active}
function getOrCreateSheet_(ss,name,headers){let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);ensureHeaders_(s,headers);return s}
function configureSheet_(s,h){ensureHeaders_(s,h);s.setFrozenRows(1);try{s.getRange(1,1,1,h.length).setFontWeight('bold')}catch(_){} }
function ensureHeaders_(s,h){if(s.getLastRow()===0){s.getRange(1,1,1,h.length).setValues([h]);return}const ex=s.getRange(1,1,1,Math.max(h.length,s.getLastColumn())).getDisplayValues()[0];for(let i=0;i<h.length;i++)if(normalizeSearch_(ex[i])!==normalizeSearch_(h[i]))s.getRange(1,i+1).setValue(h[i])}
function nextOrderId_(sheet){const p=PropertiesService.getScriptProperties();let seq=Number(p.getProperty('TA_ORDER_SEQ')||0);if(!seq)seq=findMaxOrderNumber_(sheet);seq++;p.setProperty('TA_ORDER_SEQ',String(seq));return APP.ORDER_PREFIX+String(seq).padStart(APP.ORDER_WIDTH,'0')}
function findMaxOrderNumber_(sheet){const last=sheet.getLastRow();if(last<2)return 0;return sheet.getRange(2,1,last-1,1).getDisplayValues().flat().reduce(function(m,v){const x=String(v||'').match(/(\d+)/);return x?Math.max(m,Number(x[1])||0):m},0)}
function upsertCustomer_(input,orderId,now){const sheet=getSpreadsheet_().getSheetByName(SHEETS.CUSTOMERS);if(!sheet)return;const last=sheet.getLastRow(),email=normalizeEmail_(input.email);let row=0;if(last>=2){const values=sheet.getRange(2,5,last-1,1).getDisplayValues().flat();for(let i=0;i<values.length;i++)if(normalizeEmail_(values[i])===email){row=i+2;break}}if(!row){sheet.appendRow(['CUS-'+hashShort_(email+'|'+Date.now()).toUpperCase(),now,now,safeCell_(input.nama),safeCell_(input.email),safeCell_(input.wa),1,orderId,'Aktif','']);return}const count=parseNumber_(sheet.getRange(row,7).getValue())+1;sheet.getRange(row,3).setValue(now);sheet.getRange(row,4).setValue(safeCell_(input.nama));sheet.getRange(row,6).setValue(safeCell_(input.wa));sheet.getRange(row,7).setValue(count);sheet.getRange(row,8).setValue(orderId)}
function findRequest_(clientRequestId){const sheet=getSpreadsheet_().getSheetByName(SHEETS.REQUESTS);if(!sheet||sheet.getLastRow()<2)return null;const target=normalizeClientRequestId_(clientRequestId),rows=sheet.getRange(2,1,sheet.getLastRow()-1,4).getDisplayValues();for(let i=rows.length-1;i>=0;i--)if(String(rows[i][0]).trim()===target)return rows[i][1];return null}
function saveRequest_(clientRequestId,orderId,requestId){const sheet=getSpreadsheet_().getSheetByName(SHEETS.REQUESTS);if(sheet)sheet.appendRow([clientRequestId,orderId,new Date(),hashShort_(clientRequestId+'|'+orderId+'|'+requestId)])}
function writeAudit_(requestId,actor,action,entityId,result,detail){try{const s=getSpreadsheet_().getSheetByName(SHEETS.AUDIT);if(s)s.appendRow([new Date(),safeCell_(requestId),safeCell_(actor),safeCell_(action),safeCell_(entityId),safeCell_(result),safeCell_(detail)])}catch(e){Logger.log('Audit log gagal: '+e)}}
function logError_(requestId,action,code,err){try{const s=getSpreadsheet_().getSheetByName(SHEETS.ERRORS);if(s)s.appendRow([new Date(),safeCell_(requestId),safeCell_(action),safeCell_(code),safeCell_(err&&err.message?err.message:String(err)),safeCell_(err&&err.stack?err.stack:'')])}catch(e){Logger.log('Error log gagal: '+e)}}
function writeSetting_(sheet,key,value,description){if(!sheet)return;const last=sheet.getLastRow();let row=0;if(last>=2){const keys=sheet.getRange(2,1,last-1,1).getDisplayValues().flat();for(let i=0;i<keys.length;i++)if(String(keys[i]).trim()===key){row=i+2;break}}if(!row)row=sheet.getLastRow()+1;sheet.getRange(row,1,1,4).setValues([[key,value,description,new Date()]])}
function enforcePublicTrackRateLimit_(id){enforceRateLimit_('public-track:'+hashShort_(normalizeOrderId_(id)||'invalid'),APP.PUBLIC_TRACK_LIMIT,APP.PUBLIC_TRACK_WINDOW)}
function enforceRateLimit_(key,limit,windowSeconds){if(!checkRate_(key,limit,windowSeconds))throw appError_('RATE_LIMITED','Terlalu banyak permintaan. Tunggu beberapa menit lalu coba lagi.')}
function checkRate_(key,limit,windowSeconds){const c=CacheService.getScriptCache(),k='rl:'+hashShort_(key),n=Number(c.get(k)||0);if(n>=limit)return false;c.put(k,String(n+1),windowSeconds);return true}
function requireAdmin_(token){const clean=String(token||'').trim();if(!clean||clean.length<20)throw appError_('ADMIN_REQUIRED','Sesi admin diperlukan.');if(!CacheService.getScriptCache().get('admin:'+clean))throw appError_('ADMIN_SESSION_EXPIRED','Sesi admin kedaluwarsa. Silakan login lagi.');return true}
