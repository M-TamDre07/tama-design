function normalizeOrderInput_(p){const nama=sanitizePlain_(p.Nama||p['Nama Lengkap']||p.nama||'',80),email=normalizeEmail_(p.Email||p['Alamat Email']||''),wa=String(p.WA||p.WhatsApp||p['Kontak/WA']||p['No. WhatsApp']||'').replace(/[^\d+]/g,''),kategori=sanitizePlain_(p.Kategori||p['Kategori Layanan']||p['Jenis Desain']||'',50),layanan=sanitizePlain_(p.Layanan||p['Layanan Dipilih']||p.service||'',1000),os=sanitizePlain_(p.OS||p['Pilihan OS']||'',80),metode=sanitizePlain_(p.Metode||p['Metode Layanan']||'',180),brief=sanitizePlain_(p.Brief||p['Rincian Brief']||p['Keterangan Proyek']||'',5000);if(nama.length<2)throw appError_('VALIDATION_ERROR','Nama minimal 2 karakter.');if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw appError_('VALIDATION_ERROR','Format email tidak valid.');if(wa&&!/^\+?\d{8,15}$/.test(wa))throw appError_('VALIDATION_ERROR','Nomor WhatsApp tidak valid.');if(kategori&&!/Desain|Servis/i.test(kategori))throw appError_('VALIDATION_ERROR','Kategori layanan tidak dikenali.');if(layanan.length<2)throw appError_('VALIDATION_ERROR','Layanan belum dipilih.');if(brief.length<5)throw appError_('VALIDATION_ERROR','Keterangan kebutuhan terlalu singkat.');if(os&&APP.OS.indexOf(os)===-1)throw appError_('VALIDATION_ERROR','Pilihan OS tidak dikenali.');if(metode&&APP.METHOD.indexOf(metode)===-1)throw appError_('VALIDATION_ERROR','Metode layanan tidak dikenali.');if(/desain/i.test(kategori)&&/(Paket OS|Diagnosis PC|SSD\/HDD|Pasang|Restore \/ Flash iPhone|Find Hub|Find My|Microsoft Office|Driver & update|Kompatibilitas)/i.test(layanan))throw appError_('VALIDATION_ERROR','Layanan IT tidak cocok dengan kategori desain.');if(/servis/i.test(kategori)&&/(Poster|Banner|Logo|Presentasi|Media Sosial|Foto Produk)/i.test(layanan))throw appError_('VALIDATION_ERROR','Layanan desain tidak cocok dengan kategori servis IT.');if(/Android/i.test(layanan)&&/coming soon/i.test(layanan))throw appError_('VALIDATION_ERROR','Layanan Android belum tersedia.');return{nama:nama,email:email,wa: