function updateOrderFromConsole(id,p,t){requireAdmin_(t);const f=findOrderRow_(orderId_(id));if(!f)throw err_('NOT_FOUND','Pesanan tidak ditemukan.');const x=p||{},r=f.values.slice();if(has_(x,'status'))r[12]=enum_(x.status,APP.STATUS,'Status');if(has_(x,'payment'))r[14]=enum_(x.payment,APP.PAYMENT,'Status pembayaran');if(has_(x,'statusPembayaran'))r[14]=enum_(x.statusPembayaran,APP.PAYMENT,'Status pembayaran');if(has_(x,'revisi'))r[15]=int_(x.revisi,0,99,'Revisi');if(has_(x,'jumlahRevisi'))r[15]=int_(x.jumlahRevisi,0,99,'Revisi');if(has_(x,'priority'))r[17]=enum_(x.priority,APP.PRIORITY,'Prioritas');if(has_(x,'prioritas'))r[17]=enum_(x.prioritas,APP.PRIORITY,'Prioritas');if(has_(x,'link'))r[16]=safeCell_(x.link);if(has_(x,'note'))r[21]=safeCell_(x.note);if(has_(x,'catatan'))r[21]=safeCell_(x.catatan);if(has_(x,'tenggat'))r[11]=parseDate_(x.tenggat);r[2]=new Date();r[18]=daysLeft_(r[11]);f.sheet.getRange(f.row,1,1,H.ORDERS.length).setValues([r]);writeAudit_(rid_(),'admin','UPDATE_ORDER',f.values[0],'SUCCESS','Order diperbarui.');return{status:'ok',order:rowOrder_(r,f.row)};}
