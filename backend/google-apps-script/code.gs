function upsertCustomer_(input,orderId,now){const sheet=getSpreadsheet_().getSheetByName(SHEETS.CUSTOMERS);if(!sheet)return;const last=sheet.getLastRow(),email=normalizeEmail_(input.email);let row=0;if(last>=2){const values=sheet.getRange(2,5,last-1,1).getDisplayValues().flat();for(let i=0;i<values.length;i++)if(normalizeEmail_(values[i])===email){row=i+2;break}}if(!row){sheet.appendRow(['CUS-'+hashShort_(email+'|'+Date.now()).toUpperCase(),now,now,safeCell_(input.nama),safeCell_(input.email),safeCell_(input.wa),1,orderId,'Aktif','']);return}const count=parseNumber_(sheet.getRange(row,7).getValue())+1;sheet.getRange(row,3).setValue(now);sheet.getRange(row,4).setValue(safeCell_(input.nama));sheet.getRange(row,6).setValue(safeCell_(input.wa));sheet.getRange(row,7).setValue(count);sheet.getRange(row,8).setValue(orderId)}
function findRequestIndex_(clientRequestId){const sheet=getSpreadsheet_().getSheetByName(SHEETS.REQUESTS);if(!sheet||sheet.getLastRow()<2)return null;const target=normalizeClientRequestId_(clientRequestId),values=sheet.getRange(2,1,sheet.getLastRow()-1,4).getDisplayValues();for(let i=values.length-1;i>=0;i--)if(String(values[i][0]).trim()===target)return{orderId:values[i][1],row:i+2};return null}
function saveRequestIndex_(clientRequestId,orderId,requestId){const sheet=getSpreadsheet_().getSheetByName(SHEETS.REQUESTS);if(sheet)sheet.appendRow([clientRequestId,orderId,new Date(),hashShort_(clientRequestId+'|'+orderId+'|'+requestId)])}
function writeAudit_(requestId,actor,action,entityId,result,detail){try{const sheet=getSpreadsheet_().getSheetByName(SHEETS.AUDIT);if(sheet)sheet.appendRow([new Date(),safeCell_(requestId),safeCell_(actor),safeCell_(action),safeCell_(entityId),safeCell_(result),safeCell_(detail)])}catch(_){}}
function logError_(requestId,action,code,err){try{const sheet=getSpreadsheet_().getSheetByName(SHEETS.ERRORS);if(sheet)sheet.appendRow([new Date(),safeCell_(requestId),safeCell_(action),safeCell_(code),safeCell_(err&&err.message?err.message:String(err)),safeCell_(err&&err.stack?err.stack:'')])}catch(_){}}
function enforcePublicTrackRateLimit_(id){enforceRateLimit_('public-track:'+hashShort_(normalizeOrderId_(id)||'invalid'),APP.PUBLIC_TRACK_LIMIT,APP.PUBLIC_TRACK_WINDOW)}
function enforceRateLimit_(key,maxCount,windowSeconds){if(!checkRate_(key,maxCount,windowSeconds))throw appError_('RATE_LIMITED','Terlalu banyak permintaan. Tunggu beberapa menit lalu coba lagi.')}
function checkRate_(key,limit,windowSeconds){const c=CacheService.getScriptCache(),k='rl:'+hashShort_(key),n=Number(c.get(k)||0);if(n>=limit)return false;c.put(k,String(n+1),windowSeconds);return true}
function getSpreadsheet_(){const p=PropertiesService.getScriptProperties(),id=String(p.getProperty('TA_SPREADSHEET_ID')||'').trim();if(id){try{return SpreadsheetApp.openById(id)}catch(_){throw appError_('CONFIG_ERROR','Spreadsheet ID pada Script Properties tidak dapat dibuka.')}}const active=SpreadsheetApp.getActiveSpreadsheet();if(!active)throw appError_('SETUP_REQUIRED','Spreadsheet aktif tidak ditemukan.');return active}
function getOrCreateSheet_(ss,name,headers){let sheet=ss.getSheetByName(name);if(!sheet)sheet=ss.insertSheet(name);ensureHeaders_(sheet,headers);return sheet}
function configureSheet_(sheet,headers){ensureHeaders_(sheet,headers);sheet.setFrozenRows(1);try{sheet.getRange(1,1,1,headers.length).setFontWeight('bold');sheet.autoResizeColumns(1,headers.length)}catch(_){}}
function ensureHeaders_(sheet,headers){if(sheet.getLastRow()===0){sheet.getRange(1,1,1,headers.length).setValues([headers]);return}const existing=sheet.getRange(1,1,1,Math.max(headers.length,sheet.getLastColumn())).getDisplayValues()[0];headers.forEach(function(h,i){if(normalizeSearch_(existing[i])!==normalizeSearch_(h))sheet.getRange(1,i+1).setValue(h)})}
function normalizeOrderId_(value){const text=sanitizePlain_(value,40).toUpperCase();if(!text)return'';const id=text.indexOf(APP.ORDER_PREFIX)===0?text:APP.ORDER_PREFIX+text;return/^ORD-\d{1,12}$/.test(id)?id:''}
function normalizeClientRequestId_(value){const text=sanitizePlain_(value,100);if(!text)return'';if(!/^[A-Za-z0-9._:-]{8,100}$/.test(text))throw appError_('VALIDATION_ERROR','Client Request ID tidak valid.');return text}
function normalizeSearch_(value){return String(value==null?'':value).toLowerCase().trim()}
function normalizeEmail_(value){return String(value||'').trim().toLowerCase()}
function sanitizePlain_(value,max){const text=String(value==null?'':value).replace(/[\u0000-\u001F\u007F]/g,' ').replace(/\s+/g,' ').trim();return text.length>max?text.slice(0,max):text}
function safeCell_(value){const text=sanitizePlain_(value,10000);return/^[=+\-@]/.test(text)?"'"+text:text}
function parseNumber_(value){const n=Number(String(value==null?'':value).replace(/[^\d.-]/g,''));return isNaN(n)?0:n}
function formatRupiah_(value){return new Intl.NumberFormat('id-ID').format(parseNumber_(value))}
function roundToThousand_(value){return Math.max(0,Math.round(Number(value||0)/1000)*1000)}
function formatDate_(value){const d=value instanceof Date?value:new Date(value);return isNaN(d.getTime())?'':Utilities.formatDate(d,APP.TIMEZONE,'dd/MM/yyyy')}
function formatDateTime_(value){const d=value instanceof Date?value:new Date(value);return isNaN(d.getTime())?'':Utilities.formatDate(d,APP.TIMEZONE,'dd/MM/yyyy HH:mm:ss')}
function formatDateTimeValue_(value){if(!value)return'';try{return formatDateTime_(value)}catch(_){return String(value)}}
function formatDateValue_(value){if(!value)return'';try{return formatDate_(value)}catch(_){return String(value)}}
function nowIso_(){return new Date().toISOString()}
function computeDaysLeft_(dateValue){if(!dateValue)return'';const due=dateValue instanceof Date?dateValue:new Date(dateValue);if(isNaN(due.getTime()))return'';const now=new Date(),start=new Date(now.getFullYear(),now.getMonth(),now.getDate()),end=new Date(due.getFullYear(),due.getMonth(),due.getDate());return Math.ceil((end-start)/86400000)}
function addBusinessDays_(date,days){const result=new Date(date.getTime());let left=Number(days)||0;while(left>0){result.setDate(result.getDate()+1);const day=result.getDay();if(day!==0&&day!==6)left--}return result}
function parseDateInput_(value,label){const text=sanitizePlain_(value,40);if(!text)throw appError_('VALIDATION_ERROR',label+' diperlukan.');const d=new Date(text);if(isNaN(d.getTime()))throw appError_('VALIDATION_ERROR',label+' tidak valid.');return d}
function validateEnum_(value,allowed,label){const text=sanitizePlain_(value,100);if(allowed.indexOf(text)===-1)throw appError_('VALIDATION_ERROR',label+' tidak valid.');return text}
function clampInt_(value,min,max,label){const n=Number(value);if(!Number.isInteger(n)||n<min||n>max)throw appError_('VALIDATION_ERROR',label+' tidak valid.');return n}
function hasOwn_(obj,key){return Object.prototype.hasOwnProperty.call(obj,key)}
function validatePayloadSize_(payload){if(JSON.stringify(payload||{}).length>APP.MAX_BODY_BYTES)throw appError_('PAYLOAD_TOO_LARGE','Data yang dikirim terlalu besar.')}
function valueString_(value){return value==null?'':String(value)}
function formatDateTimeValueSafe_(value){return formatDateTimeValue_(value)}
function formatDateTime_(v){const d=v instanceof Date?v:new Date(v);return isNaN(d.getTime())?'':Utilities.formatDate(d,APP.TIMEZONE,'dd/MM/yyyy HH:mm:ss')}
