function normalizeOrderId_(v){let x=String(v||'').trim().toUpperCase().replace(/^ORD[-\s]?/,'');if(!/^\d{1,12}$/.test(x))return'';return APP.ORDER_PREFIX+x.padStart(APP.ORDER_WIDTH,'0');}
