function calculateBriefQuality_(brief){const text=String(brief||'').trim();if(!text)return 0;let score=20;if(text.length>=30)score+=15;if(text.length>=80)score+=15;if(text.length>=160)score+=10;if(/(ukuran|size|dimensi|px|cm|mm)/i.test(text))score+=10;if(/(deadline|tenggat|tanggal|besok|hari)/i.test(text))score+=10;if(/(referensi|contoh|warna|brand|target|tujuan)/i.test(text))score+=15;if(/(format|png|jpg|pdf|pptx|ai|psd|svg)/i.test(text))score+=5;return Math.min(100,score)}
