function analyzeOrder_(layanan,briefText,os){const layananNorm=String(layanan||''),brief=String(briefText||'').toLowerCase(),selected=layananNorm.split(',').map(x=>x.trim()).filter(Boolean);let base=0,minPrice=0,maxPrice=0,known=0;selected.forEach(function(item){const key=Object.keys(SERVICE_CATALOG).find(k=>item.indexOf(k)!==-1||k.indexOf(item)!==-1);if(key){const c=SERVICE_CATALOG[key];base+=c.base;minPrice+=c.min;maxPrice+=c.max;known++}else{base+=25000;minPrice+=25000;maxPrice+=50000}});if(!base){base=/servis|OS|Windows|Ubuntu|Debian|Kali|RAM|CPU|GPU|PSU|SSD|HDD|iPhone/i.test(layananNorm)?90000:20000;minPrice=base;maxPrice=base}const urgent=['urgent','besok','segera','buru','mendesak','hari ini','malam ini'].some(k=>brief.indexOf(k)!==-1),complex=['3d','animasi','manipulasi','detail','banyak halaman','banyak konsep','multi','branding lengkap','revisi banyak','kompleks'].some(k=>brief.indexOf(k)!==-1),light=['sederhana','simple','simpel','ringan','satu halaman','satu desain'].some(k=>brief.indexOf(k)!==-1);let multiplier=1,priority='Normal',days=/it-|diagnosis|backup|driver|pasang|OS|SSD|HDD|iPhone/i.test(layananNorm)?2:3;const risks=[];if(urgent){multiplier*=1.1;priority='Tinggi';days=Math.max(1,days-1);risks.push('deadline-mendesak')}if(complex){multiplier*=1.15;if(priority!=='Tinggi')priority='Menengah';days+=2;risks.push('brief-kompleks')}if(light&&!urgent&&!complex){multiplier*=0.95;priority='Rendah';days=Math.max(1,days-1)}const quality=calculateBriefQuality_(briefText);if(quality<50)risks.push('brief-perlu-diperjelas');if(!os&&/install|instalasi|OS|Windows|Ubuntu|Debian|Kali/i.test(layananNorm))risks.push('OS-belum-dipilih');if(known<selected.length)risks.push('layanan-tidak-dikenal');const fixed=selected.length===1&&minPrice===maxPrice;const finalPrice=roundToThousand_(fixed?base:base*multiplier);return{finalPriceIDR:finalPrice,minPriceIDR:roundToThousand_(minPrice*multiplier),maxPriceIDR:roundToThousand_(maxPrice*multiplier),formattedPrice:'Rp '+formatRu