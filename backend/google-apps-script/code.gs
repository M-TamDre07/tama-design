function onOpen(){SpreadsheetApp.getUi().createMenu('TA Backend').addItem('Inisialisasi / Periksa Backend','setupBackend').addItem('Health Check','runHealthCheck').addItem('Set / Ganti Password Admin','setAdminPassword').addToUi()}
function doGet(e){const rid=makeRequestId_();try{const a=getParam_(e,'action');if(a==='ping')return json_({status:'ok',version:APP.VERSION,requestId:rid,time:nowIso_()});if(a==='stats')return json_({status:'ok',requestId:rid,data:getPublicStats_(),updatedAt:formatDateTime_(new Date())});if(a==='track'){const id=normalizeOrderId_(getParam_(e,'id'));if(!id)return errorResponse_('VALIDATION_ERROR','ID pesanan diperlukan.',rid);const o=findOrderById_(id);return o?json_({status:'ok',requestId:rid,order:publicOrder_(o)}):errorResponse_('NOT_FOUND','Pesanan tidak ditemukan.',rid)}if(a==='admin')return renderAdmin_();return json_({status:'ok',service:'Tama Andrea Studio',version:APP.VERSION,endpoints:['ping','stats','track','verifyOrder','newOrder'],requestId:rid})}catch(err){logError_(rid,'GET',err.code||'INTERNAL_ERROR',err);return errorResponse_('INTERNAL_ERROR','Server mengalami kendala.',rid)}}
function doPost(e){const rid=makeRequestId_();let action='unknown';try{const raw=readBody_(e);action=String(raw.action||'').trim();if(action==='newOrder'){const d=raw.data||raw;const crid=String(raw.clientRequestId||d.clientRequestId||makeToken_());if(!enforceRate_('public:'+crid,APP.PUBLIC_RATE_LIMIT,APP.PUBLIC_RATE_WINDOW))throw appError_('RATE_LIMITED','Terlalu banyak permintaan.');return json_(createOrder_(d,{requestId:rid,clientRequestId:crid,source:'website'}))}if(action==='verifyOrder'){const verifyId=String(raw.id||raw.orderId||raw.data?.id||raw.data?.orderId||'');if(!enforceRate_('verify:'+verifyId,5,600))throw appError_('RATE_LIMITED','Terlalu banyak percobaan verifikasi.');return json_(verifyOrder_(verifyId,raw.name||raw.data?.name,raw.email||raw.data?.email,rid))}if(action==='adminLogin')return json_(adminLogin(String(raw.password||'')));if(action==='adminLogout')return json_(adminLogout(String(raw.token||'')));return errorResponse_('UNKNOWN_ACTION','Action tidak dikenali.',rid)}catch(err){logError_(rid,action,err.code||'INTERNAL_ERROR',err);return errorResponse_(err.code||'INTERNAL_ERROR',err.code?err.message:'Permintaan tidak dapat diproses.',rid)}}
function setupBackend(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('Spreadsheet aktif tidak ditemukan.');const maps=[[SHEETS.ORDERS,ORDER_HEADERS],[SHEETS.CUSTOMERS,CUSTOMER_HEADERS],[SHEETS.AUDIT,AUDIT_HEADERS],[SHEETS.ERRORS,ERROR_HEADERS],[SHEETS.REQUESTS,REQUEST_HEADERS],[SHEETS.SETTINGS,SETTINGS_HEADERS]];maps.forEach(x=>configureSheet_(getOrCreateSheet_(ss,x[0],x[1])));migrateLegacySheet_(ss,ss.getSheetByName(SHEETS.ORDERS));const p=PropertiesService.getScriptProperties();if(!p.getProperty('TA_ORDER_SEQ'))p.setProperty('TA_ORDER_SEQ',String(findMaxOrderNumber_(ss.getSheetByName(SHEETS.ORDERS))));const set=ss.getSheetByName(SHEETS.SETTINGS);writeSetting_(set,'BACKEND_VERSION',APP.VERSION,'Versi backend aktif.');writeSetting_(set,'CURRENCY','IDR','Harga internal Rupiah.');writeSetting_(set,'PUBLIC_TRACKING','MASKED_UNTIL_VERIFIED','Nama/email lengkap hanya setelah verifikasi.');writeSetting_(set,'INVOICE','CLIENT_SIDE_PRINT','Nota dibuat dari data terverifikasi.');SpreadsheetApp.flush();return{status:'success',version:APP.VERSION}}
function getOrCreateSheet_(ss,name,headers){let s=ss.getSheetByName(name);if(!s)s=ss.insertSheet(name);if(s.getLastRow()===0)s.getRange(1,1,1,headers.length).setValues([headers]);return s}
function configureSheet_(s){s.setFrozenRows(1);s.getRange(1,1,1,s.getLastColumn()).setFontWeight('bold')}
function migrateLegacySheet_(ss,orders){if(!orders||orders.getLastRow()>1)return;const old=ss.getSheetByName('Sheet1');if(!old||old.getLastRow()<10)return;const rows=old.getRange(10,1,old.getLastRow()-9,Math.min(old.getLastColumn(),17)).getValues().filter(r=>r[0]);if(!rows.length)return;const out=rows.map(r=>{const x=new Array(ORDER_HEADERS.length).fill('');x[0]=r[0]||'';x[1]=r[1]||'';x[2]=r[1]||'';x[3]=r[2]||'';x[4]=r[3]||'';x[5]=r[16]||'';x[6]=r[4]||'';x[10]=r[5]||'';x[11]=r[6]||'';x[12]=r[7]||'Pending';x[13]=r[8]||'';x[14]=r[9]||'Belum Bayar';x[15]=r[10]||0;x[16]=r[11]||'';x[17]=r[12]||'Normal';x[18]=r[13]||'';x[19]='legacy';x[21]=r[15]||'';return x});orders.getRange(2,1,out.length,ORDER_HEADERS.length).setValues(out)}
function runHealthCheck(){const ss=SpreadsheetApp.getActiveSpreadsheet(),out={version:APP.VERSION,time:nowIso_(),spreadsheet:ss?ss.getName():'',sheets:{}};Object.keys(SHEETS).forEach(k=>{const s=ss&&ss.getSheetByName(SHEETS[k]);out.sheets[SHEETS[k]]=!!s});out.adminPasswordConfigured=!!PropertiesService.getScriptProperties().getProperty('TA_ADMIN_PASSWORD_HASH');return out}
function setAdminPassword(){const ui=SpreadsheetApp.getUi(),r=ui.prompt('TA Backend — Password Admin','Masukkan password admin minimal 12 karakter. Password disimpan sebagai hash.',ui.ButtonSet.OK_CANCEL);if(r.getSelectedButton()!==ui.Button.OK)return;const pw=String(r.getResponseText()||'');if(pw.length<12){ui.alert('Password minimal 12 karakter.');return}const salt=makeToken_();const p=PropertiesService.getScriptProperties();p.setProperty('TA_ADMIN_PASSWORD_SALT',salt);p.setProperty('TA_ADMIN_PASSWORD_HASH',hash_(pw,salt));ui.alert('Password admin tersimpan.')}
function adminLogin(password){const rid=makeRequestId_();const p=PropertiesService.getScriptProperties(),salt=p.getProperty('TA_ADMIN_PASSWORD_SALT'),stored=p.getProperty('TA_ADMIN_PASSWORD_HASH');if(!salt||!stored)return errorObject_('ADMIN_NOT_CONFIGURED','Password admin belum disetel.',rid);if(!enforceRate_('admin-login',APP.ADMIN_RATE_LIMIT,APP.ADMIN_RATE_WINDOW))return errorObject_('RATE_LIMITED','Terlalu banyak percobaan login.',rid);if(hash_(String(password||''),salt)!==stored)return errorObject_('AUTH_FAILED','Password admin salah.',rid);const token=makeToken_(),cache=CacheService.getScriptCache();cache.put('admin:'+token,'1',APP.ADMIN_SESSION_SECONDS);writeAudit_(rid,'admin','LOGIN','','SUCCESS','Admin login');return{status:'ok',token:token,expiresIn:APP.ADMIN_SESSION_SECONDS,requestId:rid}}
function adminLogout(token){if(token)CacheService.getScriptCache().remove('admin:'+token);return{status:'ok'}}
function getDashboardData(searchTerm,token){requireAdmin_(token);const rows=readOrders_();const q=String(searchTerm||'').toLowerCase().trim();const filtered=q?rows.filter(o=>[o.id,o.nama,o.email,o.layanan,o.kontak].join(' ').toLowerCase().includes(q)):rows;const stats={totalPesanan:rows.length,pending:count_(rows,'Pending'),proses:count_(rows,'Proses'),review:count_(rows,'Review'),selesai:count_(rows,'Selesai'),estimasiRevenue:rows.reduce((n,o)=>n+Number(o.estimasi||0),0)};return{status:'ok',stats:stats,orders:filtered.slice(0,50).map(adminOrder_)}}
function saveOrderFromConsole(data,token){requireAdmin_(token);return createOrder_(data,{requestId:makeRequestId_(),clientRequestId:'admin-'+makeToken_(),source:'admin'})}
function updateOrderFromConsole(id,patch,token){requireAdmin_(token);const o=findOrderById_(id,true);if(!o)throw appError_('NOT_FOUND','Pesanan tidak ditemukan.');const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.ORDERS);const values=s.getRange(o.row,1,1,ORDER_HEADERS.length).getValues()[0];const allowed={status:12,payment:14,revisi:15,link:16,priority:17,days:18,note:21};Object.keys(allowed).forEach(k=>{if(patch&&patch[k]!==undefined)values[allowed[k]]=safeCell_(patch[k])});values[2]=new Date();s.getRange(o.row,1,1,ORDER_HEADERS.length).setValues([values]);writeAudit_(makeRequestId_(),'admin','UPDATE_ORDER',o.id,'SUCCESS',JSON.stringify(patch||{}));return{status:'ok',order:adminOrder_(findOrderById_(o.id,true))}}
function deleteOrderFromConsole(id,token){requireAdmin_(token);const o=findOrderById_(id,true);if(!o)throw appError_('NOT_FOUND','Pesanan tidak ditemukan.');SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.ORDERS).deleteRow(o.row);writeAudit_(makeRequestId_(),'admin','DELETE_ORDER',o.id,'SUCCESS','Order dihapus');return{status:'ok',id:o.id}}
function analyzeBriefFromConsole(layanan,brief,token){requireAdmin_(token);return analyze_(String(layanan||''),String(brief||''))}
function createOrder_(data,meta){const clean=normalizeInput_(data);if(!clean.nama||!clean.email||!clean.kontak||!clean.kategori||!clean.layanan||!clean.metode||!clean.brief)throw appError_('VALIDATION_ERROR','Data order belum lengkap.');const existing=findRequest_(meta.clientRequestId);if(existing)return{status:'ok',duplicate:true,orderId:existing};const lock=LockService.getScriptLock();lock.waitLock(10000);try{const ss=SpreadsheetApp.getActiveSpreadsheet(),sheet=ss.getSheetByName(SHEETS.ORDERS)||getOrCreateSheet_(ss,SHEETS.ORDERS,ORDER_HEADERS),p=PropertiesService.getScriptProperties();let seq=Number(p.getProperty('TA_ORDER_SEQ')||findMaxOrderNumber_(sheet));seq++;p.setProperty('TA_ORDER_SEQ',String(seq));const id=APP.ORDER_PREFIX+('000000'+seq).slice(-APP.ORDER_WIDTH);const analysis=analyze_(clean.layanan,clean.brief);const now=new Date();const row=[id,now,now,clean.nama,clean.email,clean.kontak,clean.kategori,clean.layanan,clean.os,clean.metode,clean.brief,clean.tenggat,'Pending',analysis.estimate,'Belum Bayar',0,'','Normal',analysis.days,meta.source||'website',meta.clientRequestId,clean.note];sheet.appendRow(row);upsertCustomer_(clean,id);rememberRequest_(meta.clientRequestId,id,meta.requestId,clean);writeAudit_(meta.requestId||makeRequestId_(),'public','CREATE_ORDER',id,'SUCCESS','Order dibuat');return{status:'ok',orderId:id,id:id,analysis:analysis}}finally{lock.releaseLock()}}
function normalizeInput_(d){d=d||{};const layanan=String(d['Layanan Dipilih']||d.layanan||d.service||'').trim();const brief=String(d['Keterangan Proyek']||d['Rincian Brief']||d.brief||'').trim();return{nama:sanitizeText_(d.Nama||d['Nama Lengkap']||d.nama,100),email:String(d.Email||d.email||'').trim().toLowerCase(),kontak:sanitizeText_(d.WhatsApp||d['Kontak/WA']||d.kontak,40),kategori:sanitizeText_(d['Jenis Desain']||d['Kategori Layanan']||d.kategori,60),layanan:layanan.slice(0,500),os:sanitizeText_(d['Pilihan OS']||d.os,60),metode:sanitizeText_(d['Metode Layanan']||d.metode,120),brief:brief.slice(0,5000),tenggat:sanitizeText_(d['Tenggat Waktu']||d.tenggat,40),note:sanitizeText_(d['Catatan Internal']||d.note,1000)}}
function analyze_(layanan,brief){const names=String(layanan||'').split(/,\s*/).filter(Boolean);let base=0,min=0,max=0;names.forEach(n=>{const item=SERVICE_CATALOG[n]||Object.keys(SERVICE_CATALOG).find(k=>n.includes(k)||k.includes(n));if(item){base+=item.base;min+=item.min;max+=item.max}});if(!base){base=25000;min=25000;max=100000}const text=String(brief||'').toLowerCase();let priority='Normal',days=2,mult=1;if(/hari ini|besok|secepatnya|urgent|mendesak/.test(text)){priority='Tinggi';mult=1.25;days=1}else if(/minggu ini|3 hari|empat hari|5 hari/.test(text)){priority='Menengah';mult=1.1;days=2}if(text.length>700){mult+=.1;days+=1}if(names.length>1){mult+=.08;days+=Math.min(2,names.length-1)}const estimate=Math.round((base*mult)/5000)*5000;return{base:base,multiplier:Number(mult.toFixed(2)),priority:priority,days:days,estimate:estimate,min:Math.round((min*mult)/5000)*5000,max:Math.round((max*mult)/5000)*5000,briefQuality:briefQuality_(brief)}}
function briefQuality_(b){const n=String(b||'').trim().length;if(n<30)return'Kurang lengkap';if(n<120)return'Cukup';if(n<400)return'Baik';return'Lengkap'}
function verifyOrder_(id,name,email,rid){const o=findOrderById_(id);if(!o)return errorObject_('NOT_FOUND','Pesanan tidak ditemukan.',rid);const ok=normalize_(name)===normalize_(o.nama)&&String(email||'').trim().toLowerCase()===String(o.email||'').trim().toLowerCase();if(!ok){writeAudit_(rid,'public','VERIFY_ORDER',o.id,'DENIED','Identitas tidak cocok');return errorObject_('VERIFICATION_FAILED','Nama dan email tidak cocok dengan pesanan.',rid)}writeAudit_(rid,'public','VERIFY_ORDER',o.id,'SUCCESS','Identitas terverifikasi');return{status:'ok',verified:true,requestId:rid,order:verifiedOrder_(o)}}
function publicOrder_(o){return{id:o.id,nama:maskName_(o.nama),layanan:o.layanan,status:o.status,tenggat:o.tenggat||'—',kategori:o.kategori,verificationRequired:true}}
function verifiedOrder_(o){return{id:o.id,tanggal:o.tanggal,nama:o.nama,email:o.email,kontak:o.kontak,kategori:o.kategori,layanan:o.layanan,os:o.os,metode:o.metode,brief:o.brief,tenggat:o.tenggat,status:o.status,estimasi:o.estimasi,payment:o.payment,revisi:o.revisi,link:o.link,priority:o.priority,days:o.days,invoice:{number:o.id,date:o.tanggal,customer:o.nama,email:o.email,service:o.layanan,amount:o.estimasi,payment:o.payment}}}
function adminOrder_(o){return{id:o.id,tanggal:o.tanggal,nama:o.nama,email:o.email,kontak:o.kontak,kategori:o.kategori,layanan:o.layanan,os:o.os,metode:o.metode,brief:o.brief,tenggat:o.tenggat,status:o.status,estimasi:o.estimasi,payment:o.payment,revisi:o.revisi,link:o.link,priority:o.priority,days:o.days,note:o.note}}
function readOrders_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.ORDERS);if(!s||s.getLastRow()<2)return[];const data=s.getRange(2,1,s.getLastRow()-1,ORDER_HEADERS.length).getValues();return data.filter(r=>r[0]).map((r,i)=>rowToOrder_(r,i+2))}
function findOrderById_(id,withRow){const target=normalizeOrderId_(id);if(!target)return null;const all=readOrders_();const o=all.find(x=>x.id===target);return withRow?o:o}
function rowToOrder_(r,row){return{row:row,id:String(r[0]||''),tanggal:formatDateTimeValue_(r[1]),updated:formatDateTimeValue_(r[2]),nama:String(r[3]||''),email:String(r[4]||''),kontak:String(r[5]||''),kategori:String(r[6]||''),layanan:String(r[7]||''),os:String(r[8]||''),metode:String(r[9]||''),brief:String(r[10]||''),tenggat:String(r[11]||''),status:String(r[12]||'Pending'),estimasi:Number(r[13]||0),payment:String(r[14]||'Belum Bayar'),revisi:Number(r[15]||0),link:String(r[16]||''),priority:String(r[17]||'Normal'),days:String(r[18]||''),source:String(r[19]||''),clientRequestId:String(r[20]||''),note:String(r[21]||'')}}
function getPublicStats_(){const key='stats:v4',cache=CacheService.getScriptCache(),hit=cache.get(key);if(hit)try{return JSON.parse(hit)}catch(e){}const rows=readOrders_();const d={totalPesanan:rows.length,selesai:count_(rows,'Selesai')};cache.put(key,JSON.stringify(d),APP.STATS_CACHE_SECONDS);return d}
function upsertCustomer_(d,id){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.CUSTOMERS);if(!s)return;const rows=s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,CUSTOMER_HEADERS.length).getValues():[];const idx=rows.findIndex(r=>String(r[4]||'').toLowerCase()===d.email);const now=new Date();if(idx<0)s.appendRow(['CUS-'+makeToken_().slice(0,8),now,now,d.nama,d.email,d.kontak,1,id,'Aktif','']);else{s.getRange(idx+2,3).setValue(now);s.getRange(idx+2,7).setValue(Number(rows[idx][6]||0)+1);s.getRange(idx+2,8).setValue(id)}}
function rememberRequest_(crid,id,rid,d){if(!crid)return;SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.REQUESTS).appendRow([crid,id,new Date(),hash_(JSON.stringify(d),'request')])}
function findRequest_(crid){if(!crid)return'';const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.REQUESTS);if(!s||s.getLastRow()<2)return'';const vals=s.getRange(2,1,s.getLastRow()-1,2).getValues();const r=vals.find(x=>String(x[0])===crid);return r?String(r[1]):''}
function requireAdmin_(token){if(!token||!CacheService.getScriptCache().get('admin:'+token))throw appError_('AUTH_REQUIRED','Sesi admin tidak valid atau sudah kedaluwarsa.')}
function enforceRate_(key,max,window){const c=CacheService.getScriptCache(),k='rl:'+key,n=Number(c.get(k)||0)+1;if(n>max)return false;c.put(k,String(n),window);return true}
function findMaxOrderNumber_(s){if(!s||s.getLastRow()<2)return 0;const vals=s.getRange(2,1,s.getLastRow()-1,1).getDisplayValues().flat();return vals.reduce((m,v)=>{const n=parseInt(String(v).replace(/\D/g,''),10);return isNaN(n)?m:Math.max(m,n)},0)}
function writeAudit_(rid,actor,action,entity,result,detail){try{const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.AUDIT);if(s)s.appendRow([new Date(),rid,actor,action,entity,result,String(detail||'').slice(0,1000)])}catch(e){}}
function logError_(rid,action,code,err){try{const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEETS.ERRORS);if(s)s.appendRow([new Date(),rid,action,code,String(err&&err.message||err).slice(0,500),String(err&&err.stack||'').slice(0,2000)])}catch(e){}}
function writeSetting_(s,key,value,desc){const rows=s.getLastRow()>1?s.getRange(2,1,s.getLastRow()-1,4).getValues():[];const i=rows.findIndex(r=>String(r[0])===key);const row=[key,value,desc,new Date()];if(i<0)s.appendRow(row);else s.getRange(i+2,1,1,4).setValues([row])}
function renderAdmin_(){return HtmlService.createTemplateFromFile('index').evaluate().setTitle('TA Backend — Admin').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function normalizeOrderId_(v){let x=String(v||'').trim().toUpperCase().replace(/^ORD[-\s]?/,'');if(!/^\d{1,8}$/.test(x))return'';return APP.ORDER_PREFIX+x.padStart(APP.ORDER_WIDTH,'0')}
function maskName_(v){const p=String(v||'').trim().split(/\s+/);if(!p.length)return'—';return p.map((x,i)=>i===0?(x.length<=2?x[0]+'*':x.slice(0,2)+'*'.repeat(Math.min(4,Math.max(1,x.length-2)))):'*'.repeat(Math.min(5,Math.max(2,x.length)))).join(' ')}
function normalize_(v){return String(v||'').toLowerCase().trim().replace(/\s+/g,' ')}
function sanitizeText_(v,max){let s=String(v==null?'':v).trim().slice(0,max||500);if(/^[=+\-@]/.test(s))s="'"+s;return s}
function safeCell_(v){const s=String(v==null?'':v);return /^[=+\-@]/.test(s)?"'"+s:s}
function hash_(value,salt){const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(salt||'')+':'+String(value||''));return bytes.map(b=>(b<0?b+256:b).toString(16).padStart(2,'0')).join('')}
function makeToken_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'')}
function makeRequestId_(){return'REQ-'+new Date().getTime().toString(36).toUpperCase()+'-'+makeToken_().slice(0,8).toUpperCase()}
function nowIso_(){return new Date().toISOString()}
function formatDateTime_(d){return Utilities.formatDate(d instanceof Date?d:new Date(d),APP.TIMEZONE,'dd/MM/yyyy HH:mm')}
function formatDateTimeValue_(v){return v instanceof Date?formatDateTime_(v):String(v||'')}
function count_(rows,status){return rows.filter(x=>x.status===status).length}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
function errorObject_(code,message,rid){return{status:'error',code:code,message:message,requestId:rid}}
function errorResponse_(code,message,rid){return json_(errorObject_(code,message,rid))}
function appError_(code,message){const e=new Error(message);e.code=code;return e}
function getParam_(e,k){return e&&e.parameter&&e.parameter[k]?e.parameter[k]:''}
function readBody_(e){const raw=e&&e.postData&&e.postData.contents||'';if(raw.length>APP.MAX_BODY_BYTES)throw appError_('PAYLOAD_TOO_LARGE','Data terlalu besar.');try{return JSON.parse(raw)}catch(err){throw appError_('INVALID_JSON','Format data tidak valid.')}}
