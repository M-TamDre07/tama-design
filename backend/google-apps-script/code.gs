function hasOwn_(o,k){return Object.prototype.hasOwnProperty.call(o,k);}function validateEnum_(v,a,l){const x=sanitizePlain_(v,120);if(a.indexOf(x)<0)throw appError_('VALIDATION_ERROR',l+' tidak valid.');return x;}function clampInt_(v,min,max,l){const n=Number(v);if(!Number.isInteger(n)||n<min||n>max)throw appError_('VALIDATION_ERROR',l+' tidak valid.');return n;}
function computeDaysLeft_(v){if(!v)return'';const d=v instanceof Date?v:new Date(v);if(isNaN(d.getTime()))return'';const t=new Date(),a=new Date(t.getFullYear(),t.getMonth(),t.getDate()),b=new Date(d.getFullYear(),d.getMonth(),d.getDate());return Math.ceil((b-a)/86400000);}function addBusinessDays_(d,n){const x=new Date(d.getTime());let r=Number(n)||0;while(r>0){x.setDate(x.getDate()+1);const w=x.getDay();if(w!==0&&w!==6)r--;}return x;}
