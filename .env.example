# Supabase Dashboard > Project Settings / API Keys.
# These values belong in Vercel Project Settings > Environment Variables.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# One or more Supabase Auth user UUIDs permitted to access /admin.html.
# Find the UUID under Authentication > Users after creating the admin user.
ADMIN_USER_IDS=REPLACE_WITH_ADMIN_USER_UUID

# Optional: send a compact new-order notice to a private Telegram admin chat.
# Never commit real bot tokens or private chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
